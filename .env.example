# Local Postgres container (docker-compose.yml). Choose your own password;
# `docker-compose up` refuses to start without one. Published on 127.0.0.1 only.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=etl_db
POSTGRES_PORT=5432

# Pipeline connection (main.py). For the local container use
# DB_HOST=localhost and the same user/password/db/port as above.
DB_NAME=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
aws_access_key_id=
aws_secret_access_key_id=
