DB_NAME=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
# TLS for the PostgreSQL connection. Remote databases must use verify-full
# (the default); disable/allow/prefer/require/verify-ca are only accepted for
# localhost or Unix sockets (e.g. docker-compose).
DB_SSLMODE=verify-full
# CA bundle that signed the server certificate (or "system" for the OS store)
DB_SSLROOTCERT=
# Seconds to wait for the connection (default 10, must be > 0)
DB_CONNECT_TIMEOUT=10
aws_access_key_id=
aws_secret_access_key_id=
