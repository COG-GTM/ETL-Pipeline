DB_NAME=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
# TLS for the PostgreSQL connection. Defaults to verify-full; disable/allow/
# prefer are only accepted for localhost or Unix sockets (e.g. docker-compose).
DB_SSLMODE=verify-full
# CA bundle that signed the server certificate (or "system" for the OS store)
DB_SSLROOTCERT=
aws_access_key_id=
aws_secret_access_key_id=
