# Local Postgres container (docker-compose.yml). Choose your own password;
# the container refuses to initialise without one. Published on 127.0.0.1 only.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=etl_db
POSTGRES_PORT=5432
# Read-only role for the pipeline (SELECT on the four source tables only).
ETL_READER_PASSWORD=

# Pipeline connection (main.py). For the local container use
# DB_HOST=localhost, DB_USER=etl_reader, DB_PASSWORD=<ETL_READER_PASSWORD>
# and the db/port above. Do not point the pipeline at the superuser.
DB_NAME=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
aws_access_key_id=
aws_secret_access_key_id=
